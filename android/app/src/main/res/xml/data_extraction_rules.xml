<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- Per-install permission-interaction state must NOT survive backup/restore or
         device transfer: a restored "already asked" flag makes the runtime-permission
         dialog get skipped (App Info opens instead) even though this install never
         asked, and runtime grants are never restored alongside it. Keep install-local. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="permissions_asked.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="permissions_asked.xml"/>
    </device-transfer>
</data-extraction-rules>